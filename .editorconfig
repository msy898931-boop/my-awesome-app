# EditorConfig — https://editorconfig.org
# Keeps editors agreeing on the basics, so a diff is the change you made and
# not a whitespace reflow.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# Trailing spaces in Markdown can be meaningful (a hard line break), so they are
# left alone here.
trim_trailing_whitespace = false

[Makefile]
# Make recipes are tabs by definition; the formatter must not touch them.
indent_style = tab
