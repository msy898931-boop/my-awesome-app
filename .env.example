# ─────────────────────────────────────────────────────────────
# gold-smc-ict-bot — environment template
# Copy to .env and fill in. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# Telegram (required for the bot surface)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI provider — Groq (free tier). Optional: without it the bot still
# produces deterministic SMC/ICT plans, just without the AI commentary.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Tried in order when the primary model's quota is spent (quota is per model).
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
# gpt-oss-120b is a reasoning model: a small cap is spent on the scratchpad and
# the reply comes back empty, so this is deliberately generous.
GROQ_MAX_TOKENS=3000

# Data providers (all keyless; listed so they can be reordered/disabled)
GOLDBOT_ENABLE_YAHOO=0
GOLDBOT_ENABLE_KRAKEN=1
GOLDBOT_ENABLE_BINANCE=1
GOLDBOT_ENABLE_GOLDAPI=1

# Archive — folds every fetch into a local file and serves it when offline.
GOLDBOT_ENABLE_ARCHIVE=1
GOLDBOT_ARCHIVE_DIR=.goldbot/archive

# Macro backdrop — the dollar and real yield, named as context, never a signal.
# Keyless and cheap, so on by default; switch off for a purely price-based read.
GOLDBOT_ENABLE_MACRO=1

# Behaviour
GOLDBOT_SYMBOL=XAUUSD
GOLDBOT_TIMEFRAMES=M5,M15,M30,H1,H4
GOLDBOT_BARS=220
GOLDBOT_MIN_RR=2.0
GOLDBOT_POLL_SECONDS=60
# A repeat command inside this window reuses the last read.
GOLDBOT_CACHE_SECONDS=90

# The unprompted heads-up before a high-impact release, in minutes. The bot
# warns this far ahead of the print, because once the blackout opens the idea is
# already withheld and the warning is too late. 0 disables it.
GOLDBOT_NEWS_ALERT_MINUTES=30

# A hard ceiling on the bot's own AI calls per day (UTC). The free Groq tier
# meters 200k tokens per model per day and a full fact sheet is ~3.4k, so an
# uncapped loop can spend the day's budget in an hour. When the cap is reached
# the card loses the commentary, never the trade.
GOLDBOT_AI_DAILY_CAP=30

# Safety switch — the bot only *reads* and *advises*. It never places orders.
GOLDBOT_ENABLE_BOT=1
