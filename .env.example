# ─────────────────────────────────────────────────────────────
# gold-smc-ict-bot — environment template
# Copy to .env and fill in. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# Telegram (required for the bot surface)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI provider — Groq (free tier). Optional: without it the bot still
# produces deterministic SMC/ICT plans, just without the AI commentary.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Tried in order when the primary model's quota is spent (quota is per model).
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
# gpt-oss-120b is a reasoning model: a small cap is spent on the scratchpad and
# the reply comes back empty, so this is deliberately generous.
GROQ_MAX_TOKENS=6000

# Data providers (all keyless; listed so they can be reordered/disabled)
GOLDBOT_ENABLE_YAHOO=0
GOLDBOT_ENABLE_KRAKEN=1
GOLDBOT_ENABLE_BINANCE=1
GOLDBOT_ENABLE_GOLDAPI=1

# Archive — folds every fetch into a local file and serves it when offline.
GOLDBOT_ENABLE_ARCHIVE=1
GOLDBOT_ARCHIVE_DIR=.goldbot/archive

# Macro backdrop — the dollar and real yield, named as context, never a signal.
# Keyless and cheap, so on by default; switch off for a purely price-based read.
GOLDBOT_ENABLE_MACRO=1

# Behaviour
GOLDBOT_SYMBOL=XAUUSD
GOLDBOT_TIMEFRAMES=M5,M15,M30,H1,H4
GOLDBOT_BARS=220
GOLDBOT_MIN_RR=2.0
GOLDBOT_POLL_SECONDS=60
# A repeat command inside this window reuses the last read.
GOLDBOT_CACHE_SECONDS=90

# The unprompted heads-up before a high-impact release, in minutes. The bot
# warns this far ahead of the print, because once the blackout opens the idea is
# already withheld and the warning is too late. 0 disables it.
GOLDBOT_NEWS_ALERT_MINUTES=30

# A hard ceiling on the bot's own AI calls per day (UTC). The free Groq tier
# meters 200k tokens per model per day and a full fact sheet is ~3.4k, so an
# uncapped loop can spend the day's budget in an hour. When the cap is reached
# the card loses the commentary, never the trade.
GOLDBOT_AI_DAILY_CAP=30

# Safety switch — the bot only *reads* and *advises*. It never places orders.
# Where everything durable lives: the bot's state file and the candle archive.
# Set it to a mounted volume on a host with an ephemeral filesystem, or a
# restart forgets the daily AI counter (the cap then resets every deploy) and
# re-fires the day's news alerts. Empty keeps the historical relative paths.
GOLDBOT_DATA_DIR=

GOLDBOT_ENABLE_BOT=1

# ─────────────────────────────────────────────────────────────
# AYZR — the second engine, and the one-month shadow test
# A model *decides* here; the main bot's arithmetic decides and the model
# only narrates. It runs as its own loop, on its own journal, on its own AI
# budget, and starts only when asked.
# ─────────────────────────────────────────────────────────────

# Off by default. Set to 1 to start the shadow test: AYZR then runs one pass
# per bar alongside the bot. Left unset, the bot is exactly as it was.
AYZR_ENABLED=0

# AYZR as its own service (python -m goldbot.ayzr): a *second* bot, in a
# *second* chat, so a shadow reading can never be confused with the bot it
# shadows. AYZR never falls back to the bot's token — half a surface is no
# surface, and it runs headless without both.
AYZR_TELEGRAM_BOT_TOKEN=
# AYZR's own chat. BotFather gives a token, not a chat id: message the new bot
# once, then run `python -m goldbot.ayzr.cli chat-id --token <token>` to read
# it out of the update Telegram delivers.
AYZR_TELEGRAM_CHAT_ID=
AYZR_POLL_SECONDS=60

# Where AYZR's journal and its own daily AI counter live. Give it the same
# mounted volume as GOLDBOT_DATA_DIR on a host with an ephemeral filesystem,
# or a restart loses the month's sample.
AYZR_DATA_DIR=

# AYZR's own Groq key. Strongly recommended: the free tier's daily token
# budget is per model, and sharing the bot's key makes the two engines
# compete for one allowance. Falls back to GROQ_API_KEY when unset.
AYZR_AI_KEY=

# The frame AYZR signals on, its model chain, and its own daily call ceiling.
AYZR_TF=M15
AYZR_AI_MODEL=openai/gpt-oss-120b
AYZR_AI_FALLBACKS=openai/gpt-oss-20b
AYZR_AI_DAILY_CAP=24

# Seconds between passes. 0 means one bar of AYZR_TF (M15 -> 900s), which is
# the sane default: a pass reads the tape the frame it signals on defines.
AYZR_INTERVAL_SECONDS=0
